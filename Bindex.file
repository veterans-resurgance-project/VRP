<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Watership Stewards</title>
  <!-- Link to External CSS -->
  <link rel="stylesheet" href="style.css">
  <!-- EmailJS SDK -->
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  <script type="text/javascript">
    (function() {
      emailjs.init("YOUR_PUBLIC_KEY"); 
    })();
  </script>
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="logo">WS</div>
    <ul class="nav-links">
      <li><a href="#program-overview">Why It Matters</a></li>
      <li><a href="gallery.html">Field Gallery</a></li>
      <li><a href="#contact" class="btn-nav">Get Involved</a></li>
    </ul>
  </nav>

  <!-- Hero Section - True Full Width with No Layout Shifts -->
  <header id="hero" style="position: relative !important; width: 100% !important; margin: 0 !important; padding: 0 !important; overflow: hidden !important;">
    <!-- THE PHOTO: Stretches naturally to 100% width with no tinted layers or overlays -->
    <img src="Screenshot_20260421-000340.png" alt="Watership Stewards Swan" style="width: 100% !important; display: block !important; height: auto !important; margin: 0 !important;">
    
    <!-- THE TYPOGRAPHY LAYER: Absolute center stamp directly over the photo -->
    <div style="position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; text-align: center !important; width: 90% !important; max-width: 1000px !important;">
      <h2 style="font-size: 5rem !important; font-weight: 800 !important; margin: 0 0 0.5rem 0 !important; color: #ffffff !important; letter-spacing: -0.02em !important; text-shadow: 2px 2px 8px rgba(0,0,0,0.85), -2px -2px 8px rgba(0,0,0,0.85) !important; line-height: 1.1 !important;">Watership Stewards</h2>
      <h1 style="font-size: 1.6rem !important; text-transform: uppercase !important; letter-spacing: 3px !important; margin: 0 !important; color: #ffffff !important; font-weight: 700 !important; text-shadow: 2px 2px 6px rgba(0,0,0,0.85), -2px -2px 6px rgba(0,0,0,0.85) !important;">Veterans Resurgence Project</h1>
    </div>
  </header>

  <!-- PASTE THE REST OF YOUR SECTIONS (Operations Bar, Overview, Wishlist, etc.) HERE -->

</body>
</html>
