        <!-- 3. WHY THIS WORK MATTERS & PARTNERSHIP FRAMEWORK (FLOWING GLASS EDITION) -->
        <section id="why-this-work-matters" style="background: linear-gradient(180deg, #1b4332 0%, #0d2119 100%) !important; color: #ffffff !important; padding: 5rem 2rem 6rem 2rem !important; border-radius: 16px !important; max-width: 1200px !important; margin: 0 auto 3rem auto !important; font-family: inherit !important; box-shadow: 0 20px 40px rgba(15,23,42,0.15) !important;">
            
