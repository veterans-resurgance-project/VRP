                    <div style="background: rgba(255, 255, 255, 0.03) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; backdrop-filter: blur(12px) !important; border-radius: 12px !important; padding: 2rem 2.5rem !important; width: 100% !important; box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;">
                        <span style="color: #4ade80 !important; font-size: 0.75rem !important; font-weight: 700; text-transform: uppercase !important; letter-spacing: 0.08em !important; display: block !important; margin-bottom: 0.5rem !important;">Private Industry</span>
                        <h3 style="color: #ffffff !important; font-size: 1.4rem !important; font-weight: 700 !important; margin: 0 0 1rem 0 !important;">Commercial Logging & Forestry Contractors</h3>
                        
                        <div style="display: grid !important; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)) !important; gap: 1.5rem !important; margin-bottom: 1.5rem !important;">
                            <div style="background: rgba(15, 23, 42, 0.4) !important; padding: 1.25rem !important; border-radius: 8px !important; border-left: 4px solid #1e6b3c !important;">
